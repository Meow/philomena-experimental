.block
  .block__header
    .block__header__title.approval-grid
      .approval-items--main
        span ID
        span Image
        span Uploader
        span Time
      .approval-items--footer.hide-mobile
        span.hide-mobile Actions
  = for image <- @images do
    .block__content.alternating-color
      .approval-grid
        .approval-items--main
          span = link ">>#{image.id}", to: ~p"/images/#{image}"
          .approval-items__details class=class_for_image(image)
            span = image_thumb(@conn, image, @image_media[image.id])
            span = warning_text(image)
          span
            - attribution = @image_attributions[image.id]
            = cond do
              - attribution.user && not attribution.anonymous ->
                = link attribution.user.name, to: ~p"/profiles/#{attribution.user}"
              - attribution.user ->
                = link anonymous_name(image, true), to: ~p"/profiles/#{attribution.user}"
              - attribution.ip || attribution.fingerprint ->
                = if attribution.ip do
                  em> = truncated_ip_link(attribution.ip)
                = if attribution.fingerprint do
                  = link_to_fingerprint(@conn, attribution.fingerprint)
              - true ->
                = anonymous_name(image)
          span = pretty_time(image.created_at)
        .approval-items--footer
          = if @image_policies[image.id].can_approve? do
            = button_to "Approve", ~p"/images/#{image}/approve", method: "post", class: "button button--state-success"
          = if @image_policies[image.id].can_manage? do
            = form_for :image, ~p"/images/#{image}/delete", [method: "post"], fn f ->
              .field.field--inline
                = text_input f, :deletion_reason, class: "input input--wide", placeholder: "Rule violation", required: true
                = submit "Delete", class: "button button--state-danger button--separate-left"
