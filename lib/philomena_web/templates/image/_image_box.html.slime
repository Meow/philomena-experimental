elixir:
  link = assigns[:link] || ~p"/images/#{@image.metadata.id}"
  size_class =
    case @size do
      :thumb ->
        "media-box__content--large"
      :medium ->
        "media-box__content--featured"
      _ ->
        "media-box__content--small"
    end

  header_class =
    case @size do
      :thumb_small ->
        "media-box__header--small"
      _ ->
        nil
    end

.media-box data-image-id=@image.metadata.id
  .media-box__header.media-box__header--link-row class=header_class data-image-id=@image.metadata.id
    a.interaction--fave href="#" rel="nofollow" data-image-id=@image.metadata.id
      span.fave-span title="Fave!"
        i.fa.fa-star
      span.favorites title="Favorites" data-image-id=@image.metadata.id = interaction_count(@image.interactions.faves_count)
    a.interaction--upvote href="#" rel="nofollow" data-image-id=@image.metadata.id
      i.fa.fa-arrow-up title="Yay!"
    span.score title="Score" data-image-id=@image.metadata.id = interaction_count(@image.interactions.score)
    a.interaction--downvote href="#" rel="nofollow" data-image-id=@image.metadata.id
      i.fa.fa-arrow-down title="Neigh!"
    a.interaction--comments href="/#{@image.metadata.id}#comments" title="Comments"
      i.fa.fa-comments
      span.comments_count data-image-id=@image.metadata.id = interaction_count(@image.interactions.comments_count)
    a.interaction--hide href="#" rel="nofollow" data-image-id=@image.metadata.id
      i.fa.fa-eye-slash title="Hide"
  .media-box__content class=size_class
    = render PhilomenaWeb.ImageView, "_image_container.html", link: link, image: @image, size: @size, conn: @conn
