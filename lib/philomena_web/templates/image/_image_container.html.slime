- link = assigns[:link] || ~p"/images/#{image_id(@image)}"

= image_container @conn, @image, @size, fn ->
  = cond do
    - image_duplicate_id(@image) ->
      .media-box__overlay
        strong Marked Duplicate

    - image_destroyed?(@image) ->
      .media-box__overlay
        strong Destroyed Content

    - image_hidden?(@image) ->
      .media-box__overlay
        strong Deleted:
        =< image_deletion_reason(@image)

    - true ->

  = case visibility_intent(@conn, @image) do
    - :image ->
      = render PhilomenaWeb.ImageView, "_image_container_contents.html", conn: @conn, image: @image, size: @size, link: link, hover_text: title_text(@image)

    - :not_rendered ->
      .media-box__overlay.js-spoiler-info-overlay
      a href=link
        ' Thumbnails not yet generated

    - :not_available ->
      .media-box__overlay.js-spoiler-info-overlay
      a href=link
        ' Thumbnails not available

    - :destroyed ->
      .media-box__overlay.js-spoiler-info-overlay
      a href=link
        ' Thumbnails not available
