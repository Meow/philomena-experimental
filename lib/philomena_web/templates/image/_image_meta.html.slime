.block.block__header
  .flex.flex--wrap.image-metabar.center--layout id="image_meta_#{@page.metadata.id}"
    .stretched-mobile-links
      a.js-prev href=~p"/images/#{@page.metadata.id}/navigate?#{[rel: "prev"] ++ scope(@conn)}" title="Previous Image (j)"
        i.fa.fa-chevron-left
      a.js-up href=~p"/images/#{@page.metadata.id}/navigate?#{[rel: "find"] ++ scope(@conn)}" title="Find this image in the global image list (i)"
        i.fa.fa-chevron-up
      a.js-next href=~p"/images/#{@page.metadata.id}/navigate?#{[rel: "next"] ++ scope(@conn)}" title="Next Image (k)"
        i.fa.fa-chevron-right
      a.js-rand href=~p"/images/random?#{scope(@conn)}" title="Random (r)"
        i.fa.fa-random
    .stretched-mobile-links
      = if @page.interactions.fave_changeset do
        a.interaction--fave href="#" rel="nofollow" data-image-id=@page.metadata.id
          span.favorites> title="Favorites" data-image-id=@page.metadata.id = interaction_count(@page.interactions.faves_count)
          span.fave-span title="Fave!"
            i.fa.fa-star
      = if @page.interactions.vote_changeset do
        a.interaction--upvote href="#" rel="nofollow" data-image-id=@page.metadata.id
          = if interaction_count(@page.interactions.upvotes_count) do
            span.upvotes> title="Upvotes" data-image-id=@page.metadata.id = interaction_count(@page.interactions.upvotes_count)
          span.upvote-span title="Yay!"
            i.fa.fa-arrow-up
      span.score.block__header__title data-image-id=@page.metadata.id = interaction_count(@page.interactions.score)
      = if @page.interactions.vote_changeset do
        a.interaction--downvote href="#" rel="nofollow" data-image-id=@page.metadata.id
          span.downvote-span title="Neigh!"
            i.fa.fa-arrow-down
          = if interaction_count(@page.interactions.downvotes_count) do
            span.downvotes< title="Downvotes" data-image-id=@page.metadata.id = interaction_count(@page.interactions.downvotes_count)
      a.interaction--comments href="#comments" title="Comments"
        i.fa.fa-comments
        span.comments_count< data-image-id=@page.metadata.id = @page.comments.comments_count
      = if @page.interactions.hide_changeset do
        a.interaction--hide href="#" rel="nofollow" data-image-id=@page.metadata.id
          span.hide-span title="Hide"
            i.fa.fa-eye-slash
    .stretched-mobile-links
      = render PhilomenaWeb.Image.SubscriptionView, "_subscription.html", subscription: @page.subscription, image_id: @page.metadata.id, conn: @conn
      = render PhilomenaWeb.ImageView, "_add_to_gallery_dropdown.html", galleries: @page.galleries, image_id: @page.metadata.id, conn: @conn
      a href=~p"/images/#{@page.metadata.id}/related" title="Related Images"
        i.fa.fa-sitemap>
        span.hide-limited-desktop.hide-mobile Related
    .stretched-mobile-links
      = case @page.media.view do
        - {:files, view} ->
          a href=view.long.uri rel="nofollow" title="View (tags in filename)"
            i.fa.fa-eye>
            | View
          a href=view.short.uri rel="nofollow" title="View (no tags in filename)"
            i.fa.fa-eye>
            | VS
        - _ ->
      = case @page.media.download do
        - {:files, download} ->
          a href=download.long.uri rel="nofollow" title="Download (tags in filename)"
            i.fa.fa-download>
            | Download
          a href=download.short.uri title="Download (no tags in filename)"
            i.fa.fa-download>
            | DS
        - _ ->
  .image-metabar.flex.flex--wrap.block__header--user-credit.center--layout#extrameta
    div
      ' Uploaded
      => pretty_time(@page.metadata.created_at)
      = render PhilomenaWeb.ImageView, "_uploader.html", page: @page, conn: @conn

    span.image-size
      | &nbsp;
      = @page.metadata.width
      | x
      = @page.metadata.height

      = if @page.metadata.duration > 0 do
        span.image-size title=@page.metadata.duration
          | &nbsp;
          - dur = trunc(@page.metadata.duration)
          - ms = trunc((@page.metadata.duration - dur)*100)
          - {mm, ss} = {div(dur, 60), rem(dur, 60)}
          = :io_lib.format("~2..0B:~2..0B.~2..0B", [mm, ss, ms])

      =<> String.upcase(to_string(@page.metadata.format))
      - size_kib = div(@page.metadata.size, 1024)
      - size_mib = Float.round(size_kib / 1024.0, 2)
      span title="#{size_kib} KiB"
        = if size_mib < 1 do
          => size_kib
          | KiB
        - else
          => size_mib
          | MiB
