- supplements = display_supplements(@image.media)
- size = assigns[:size] || :full
- embed_display = assigns[:embed_display] || false
- {:image, %{thumbnails: thumbnails}} = @image.media.representations
- uris = display_thumbnail_uris(@image.media)

= content_tag :div, [data: image_container_data(@image, size), class: "image-show-container"] do
  .block.block--fixed.block--warning.block--no-margin.image-filtered.hidden
    strong
      = link("This image is blocked by your current filter - click here to display it anyway", to: "#", data: [click_unfilter: @image.metadata.id])
    p
      = img_tag(static_path(@conn, "/images/tagblocked.svg"), width: 250, height: 250, data: [click_unfilter: @image.metadata.id])
    span.filter-explanation
    =< link("your current filter", to: ~p"/filters/#{@conn.assigns.current_filter}", class: "filter-link")
    ' .

  = if size == :full and not embed_display do
    .image-target.hidden.image-show data-scaled=scaled_value(@conn.assigns.current_user) data-supplements=JSON.encode!(supplements) data-uris=JSON.encode!(uris) data-width=@image.metadata.width data-height=@image.metadata.height data-image-size=@image.metadata.size data-mime-type=@image.metadata.mime_type
      = if @image.metadata.mime_type == "video/webm" do
        video controls=true
      - else
        picture
  - else
    .image-show.hidden
      a href=~p"/images/#{@image.metadata.id}" title=title_text(@image)
        span.imgspoiler
          - thumb = thumbnails[size]

          = if @image.metadata.mime_type == "video/webm" do
            video data-image-id=@image.metadata.id autoplay="autoplay" loop="loop" muted="muted" playsinline="playsinline"
              source src=thumb.uri type="video/webm"
              source src=supplements.mp4_thumbnails[size].uri type="video/mp4"
          - else
            picture data-image-id=@image.metadata.id
              img src=thumb.uri
