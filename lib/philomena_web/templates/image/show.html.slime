= render PhilomenaWeb.ImageView, "_image_approval_banner.html", page: @page, conn: @conn
= render PhilomenaWeb.ImageView, "_image_meta.html", page: @page, conn: @conn
= render PhilomenaWeb.ImageView, "_image_page.html", page: @page, conn: @conn

.layout--narrow
  = if @conn.assigns.advert do
    = render PhilomenaWeb.AdvertView, "_box.html", advert: @conn.assigns.advert, conn: @conn

  .image-description
    = render PhilomenaWeb.ImageView, "_description.html", description: @page.description, rendered: @rendered_description
  = if @page.description.changeset do
    = render PhilomenaWeb.Image.DescriptionView, "_form.html", image_id: @page.metadata.id, changeset: @page.description.changeset, conn: @conn

  = render PhilomenaWeb.ImageView, "_tags.html", image_id: @page.metadata.id, tags: @page.tags, conn: @conn
  = render PhilomenaWeb.ImageView, "_source.html", image_id: @page.metadata.id, sources: @page.sources, conn: @conn
  = render PhilomenaWeb.ImageView, "_options.html", page: @page, conn: @conn

  h4 Comments
  = cond do
    - @conn.assigns.current_ban ->
      = render PhilomenaWeb.BanView, "_ban_reason.html", conn: @conn

    - @page.comments.changeset ->
      = render PhilomenaWeb.Image.CommentView, "_form.html", image_id: @page.metadata.id, changeset: @page.comments.changeset, remote: true, conn: @conn

    - true ->

  #comments data-current-url=~p"/images/#{@page.metadata.id}/comments" data-loaded="true"
    = render PhilomenaWeb.Image.CommentView, "index.html", image_id: @page.metadata.id, comments_count: @page.comments.comments_count, comments: @page.comments.comments, conn: @conn
