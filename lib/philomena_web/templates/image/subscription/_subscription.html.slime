elixir:
  image_id = assigns[:image_id] || @image
  watching = if assigns[:subscription], do: @subscription.subscribed?, else: @watching
  available = if assigns[:subscription], do: @subscription.changeset, else: @conn.assigns.current_user
  watch_path = ~p"/images/#{image_id}/subscription"
  watch_class = if watching, do: "hidden", else: ""

  unwatch_path = ~p"/images/#{image_id}/subscription"
  unwatch_class = if watching, do: "", else: "hidden"

= if available do
  span.js-subscription-target
    a.js-subscription-link href=watch_path class=watch_class data-remote="true" data-method="post"
      i.fa.fa-bell>
      ' Subscribe

    a.js-subscription-link href=unwatch_path class=unwatch_class data-remote="true" data-method="delete"
      i.fa.fa-bell-slash>
      ' Unsubscribe
- else
    a href=~p"/sessions/new"
      i.fa.fa-bell>
      ' Subscribe
